{
  "Environment": {
    "TestSiteUrl": "https://www.phptravels.net/",
    "RunOnGrid": false,
    "GridHubIp": "10.0.0.14",
    "GridPort": "4444"
  },
  "Browser": {
    "TestedBrowser": "chrome",
    "HighlightElements": true
  },
  "Timeouts": {
    "DefaultTimeoutInSeconds": 30,
    "PollingIntervalMs": 500
  },
  "Screenshots": {
    "EnableScreenshots": true
  },
  "HttpSettings": {
    "TimeoutSeconds": 10,
    "RetryCount": 2,
    "RetryDelayMs": 250,
    "MaxExpectedResponseTimeMs": 5000,
    "FilterByDomain": true
  },
  "FrameworkLogging": {
    "Mode": "AllTests", // Options: AllTests or PerTest
    "MaxLogsPerTest": 3 // Number of recent logs to keep per test
  }
}
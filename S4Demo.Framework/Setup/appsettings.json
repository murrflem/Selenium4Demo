{
  "Environment": {
    "TestSiteUrl": "https://automationteststore.com/",
    "RunOnGrid": false,
    "GridHubIp": "localhost",
    "GridPort": "4445"
  },
  "Browser": {
    "TestedBrowser": "chrome",
    "HighlightElements": true
  },
  "Timeouts": {
    "DefaultTimeoutInSeconds": 30,
    "PollingIntervalMs": 500
  },
  "Screenshots": {
    "EnableScreenshots": true
  },
  "HttpSettings": {
    "TimeoutSeconds": 10,
    "RetryCount": 2,
    "RetryDelayMs": 250,
    "MaxExpectedResponseTimeMs": 5000,
    "FilterByDomain": true
  },
  "FrameworkLogging": {
    "Mode": "AllTests",
    "MaxLogsPerTest": 3
  },
  "VisualComparison": {
    "PixelTolerance": 15,
    "FailOnDifference": false
  }
}